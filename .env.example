# URL do WebRP (produção ou local para desenvolvimento)
WEBRP_URL=https://webriopreto.com

# Credenciais opcionais para pré-preencher o login (desenvolvimento)
WEBRP_EMAIL=
WEBRP_SENHA=

# Banco MySQL do WebRP (cruzamento e importação direta — mesmas variáveis do painel)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Sugestões de busca com Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
